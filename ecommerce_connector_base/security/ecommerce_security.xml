<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_ecommerce_connector" model="ir.module.category">
            <field name="name">E-commerce Connector</field>
            <field name="description">Manage e-commerce sales synchronization and connector configuration.</field>
            <field name="sequence">50</field>
        </record>
        <record id="group_ecommerce_connector_user" model="res.groups">
            <field name="name">E-commerce Connector User</field>
            <field name="category_id" ref="ecommerce_connector_base.module_category_ecommerce_connector"/>
        </record>

        <record id="group_ecommerce_connector_manager" model="res.groups">
            <field name="name">E-commerce Connector Manager</field>
            <field name="category_id" ref="ecommerce_connector_base.module_category_ecommerce_connector"/>
            <field name="implied_ids" eval="[(4, ref('ecommerce_connector_base.group_ecommerce_connector_user'))]"/>
        </record>

        <record id="group_ecommerce_integration_manager" model="res.groups">
            <field name="name">E-commerce Integration Manager</field>
            <field name="category_id" ref="ecommerce_connector_base.module_category_ecommerce_connector"/>
            <field name="implied_ids" eval="[(4, ref('ecommerce_connector_base.group_ecommerce_connector_manager'))]"/>
        </record>

    </data>
</odoo>
