<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ecommerce_customer_mapping_tree" model="ir.ui.view">
        <field name="name">ecommerce.customer.mapping.tree</field>
        <field name="model">ecommerce.customer.mapping</field>
        <field name="arch" type="xml">
            <list string="Customer Mappings" create="0">
                <field name="store_id"/>
                <field name="external_customer_id"/>
                <field name="partner_id"/>
                <field name="external_email" optional="show"/>
                <field name="external_phone" optional="show"/>
                <field name="last_order_at" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_ecommerce_customer_mapping_form" model="ir.ui.view">
        <field name="name">ecommerce.customer.mapping.form</field>
        <field name="model">ecommerce.customer.mapping</field>
        <field name="arch" type="xml">
            <form string="Customer Mapping">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="external_customer_id"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="external_email"/>
                            <field name="external_phone"/>
                            <field name="normalized_phone"/>
                            <field name="last_order_at"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ecommerce_customer_mapping_search" model="ir.ui.view">
        <field name="name">ecommerce.customer.mapping.search</field>
        <field name="model">ecommerce.customer.mapping</field>
        <field name="arch" type="xml">
            <search string="Customer Mappings">
                <field name="external_customer_id"/>
                <field name="partner_id"/>
                <field name="store_id"/>
                <field name="external_email"/>
                <field name="external_phone"/>
                <field name="normalized_phone"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Store" name="group_by_store" context="{'group_by': 'store_id'}"/>
                    <filter string="Partner" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ecommerce_customer_mapping" model="ir.actions.act_window">
        <field name="name">Customer Mappings</field>
        <field name="res_model">ecommerce.customer.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ecommerce_customer_mapping_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No customer mappings found.
            </p>
            <p>
                Customer mappings are created automatically when orders are imported.
            </p>
        </field>
    </record>

</odoo>
