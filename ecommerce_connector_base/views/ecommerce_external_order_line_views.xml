<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_ecommerce_external_order_line_list" model="ir.ui.view">
        <field name="name">ecommerce.external.order.line.list</field>
        <field name="model">ecommerce.external.order.line</field>
        <field name="arch" type="xml">
            <list
                string="External Order Lines"
                decoration-success="state == 'mapped'"
                decoration-warning="state == 'pending_mapping'"
                decoration-danger="state == 'failed'"
            >
                <field name="external_order_id"/>
                <field name="store_id"/>
                <field name="external_line_id"/>
                <field name="external_product_id"/>
                <field name="external_variant_id"/>
                <field name="external_sku"/>
                <field name="product_name"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="subtotal"/>
                <field name="product_id"/>
                <field name="match_method"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ecommerce_external_order_line_form" model="ir.ui.view">
        <field name="name">ecommerce.external.order.line.form</field>
        <field name="model">ecommerce.external.order.line</field>
        <field name="arch" type="xml">
            <form string="External Order Line">
                <sheet>
                    <group>
                        <group string="Order">
                            <field name="external_order_id"/>
                            <field name="store_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                        </group>

                        <group string="External Product">
                            <field name="external_line_id"/>
                            <field name="external_product_id"/>
                            <field name="external_variant_id"/>
                            <field name="external_sku"/>
                            <field name="product_name"/>
                        </group>
                    </group>

                    <group>
                        <group string="Amounts">
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="subtotal"/>
                            <field name="discount_amount"/>
                            <field name="tax_amount"/>
                        </group>

                        <group string="Mapping">
                            <field name="product_id"/>
                            <field name="match_method"/>
                            <field name="state"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Raw Line Payload">
                            <field name="raw_line_payload" nolabel="1"/>
                        </page>

                        <page string="Error">
                            <field name="error_message" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ecommerce_external_order_line_search" model="ir.ui.view">
        <field name="name">ecommerce.external.order.line.search</field>
        <field name="model">ecommerce.external.order.line</field>
        <field name="arch" type="xml">
            <search string="Search External Order Lines">
                <field name="external_order_id"/>
                <field name="store_id"/>
                <field name="external_product_id"/>
                <field name="external_variant_id"/>
                <field name="external_sku"/>
                <field name="product_name"/>
                <field name="product_id"/>
                <field name="state"/>
                <field name="match_method"/>

                <separator/>

                <filter name="filter_pending_mapping" string="Pending Mapping" domain="[('state', '=', 'pending_mapping')]"/>
                <filter name="filter_mapped" string="Mapped" domain="[('state', '=', 'mapped')]"/>
                <filter name="filter_failed" string="Failed" domain="[('state', '=', 'failed')]"/>

                <group expand="0" string="Group By">
                    <filter name="group_by_order" string="External Order" context="{'group_by': 'external_order_id'}"/>
                    <filter name="group_by_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_match_method" string="Match Method" context="{'group_by': 'match_method'}"/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ecommerce_external_order_line" model="ir.actions.act_window">
        <field name="name">External Order Lines</field>
        <field name="res_model">ecommerce.external.order.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ecommerce_external_order_line_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No external order lines yet.
            </p>
            <p>
                External order lines stage external products before Odoo product mapping.
            </p>
        </field>
    </record>

</odoo>
