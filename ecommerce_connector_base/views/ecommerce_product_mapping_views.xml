<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ecommerce_product_mapping_tree" model="ir.ui.view">
        <field name="name">ecommerce.product.mapping.tree</field>
        <field name="model">ecommerce.product.mapping</field>
        <field name="arch" type="xml">
            <list string="Product Mappings" edit="1" editable="top">
                <field name="store_id" />
                <field name="external_product_id" />
                <field name="external_variant_id" />
                <field name="external_sku" />
                <field name="product_id"/>
                <field name="last_seen_at" readonly="1" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ecommerce_product_mapping_form" model="ir.ui.view">
        <field name="name">ecommerce.product.mapping.form</field>
        <field name="model">ecommerce.product.mapping</field>
        <field name="arch" type="xml">
            <form string="Product Mapping">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="external_product_id"/>
                            <field name="external_variant_id"/>
                            <field name="external_sku"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="last_seen_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ecommerce_product_mapping_search" model="ir.ui.view">
        <field name="name">ecommerce.product.mapping.search</field>
        <field name="model">ecommerce.product.mapping</field>
        <field name="arch" type="xml">
            <search string="Product Mappings">
                <field name="external_product_id"/>
                <field name="external_variant_id"/>
                <field name="external_sku"/>
                <field name="product_id"/>
                <field name="store_id"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Store" name="group_by_store" context="{'group_by': 'store_id'}"/>
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ecommerce_product_mapping" model="ir.actions.act_window">
        <field name="name">Product Mappings</field>
        <field name="res_model">ecommerce.product.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ecommerce_product_mapping_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No product mappings found.
            </p>
            <p>
                Product mappings connect external e-commerce products and variants to Odoo products.
            </p>
        </field>
    </record>

</odoo>
