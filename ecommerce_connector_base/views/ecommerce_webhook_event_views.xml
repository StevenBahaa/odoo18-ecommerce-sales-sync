<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_ecommerce_webhook_event_list" model="ir.ui.view">
        <field name="name">ecommerce.webhook.event.list</field>
        <field name="model">ecommerce.webhook.event</field>
        <field name="arch" type="xml">
            <list
                string="Webhook Events"
                decoration-success="processing_status == 'processed'"
                decoration-warning="processing_status in ('pending_review', 'rate_limited')"
                decoration-danger="processing_status in ('failed', 'invalid_signature')"
                decoration-muted="processing_status in ('ignored', 'duplicate')"
            >
                <field name="create_date"/>
                <field name="name"/>
                <field name="store_id"/>
                <field name="platform"/>
                <field name="event_type"/>
                <field name="external_event_id"/>
                <field name="external_order_id"/>
                <field name="related_external_order_id"/>
                <field name="signature_valid"/>
                <field name="processing_status"/>
                <field name="http_status_returned"/>
                <field name="processed_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ecommerce_webhook_event_form" model="ir.ui.view">
        <field name="name">ecommerce.webhook.event.form</field>
        <field name="model">ecommerce.webhook.event</field>
        <field name="arch" type="xml">
            <form string="Webhook Event" create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_mark_received"
                        string="Mark as Received"
                        type="object"
                        class="btn-secondary"
                        groups="ecommerce_connector_base.group_ecommerce_connector_manager"
                        invisible="processing_status not in ('failed', 'pending_review')"
                    />
                    <field
                        name="processing_status"
                        widget="statusbar"
                        statusbar_visible="received,processed,pending_review,failed"
                    />
                </header>

                <sheet>
                    <group>
                        <group string="Event">
                            <field name="name"/>
                            <field name="store_id"/>
                            <field name="platform"/>
                            <field name="event_type"/>
                            <field name="external_event_id"/>
                            <field name="external_order_id"/>
                        </group>

                        <group string="Processing">
                            <field name="signature_valid"/>
                            <field name="http_status_returned"/>
                            <field name="processed_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <group string="Related Records">
                        <field name="related_external_order_id"/>
                        <field name="related_sale_order_id"/>
                        <field name="related_partner_id"/>
                        <field name="related_product_id"/>
                    </group>

                    <notebook>
                        <page string="Raw Payload">
                            <field name="raw_payload" nolabel="1"/>
                        </page>

                        <page string="Request Headers">
                            <field name="headers_json" nolabel="1"/>
                        </page>

                        <page string="Error">
                            <field name="error_message" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ecommerce_webhook_event_search" model="ir.ui.view">
        <field name="name">ecommerce.webhook.event.search</field>
        <field name="model">ecommerce.webhook.event</field>
        <field name="arch" type="xml">
            <search string="Search Webhook Events">
                <field name="name"/>
                <field name="store_id"/>
                <field name="event_type"/>
                <field name="external_event_id"/>
                <field name="external_order_id"/>
                <field name="processing_status"/>

                <separator/>

                <filter name="filter_received" string="Received" domain="[('processing_status', '=', 'received')]"/>
                <filter name="filter_processed" string="Processed" domain="[('processing_status', '=', 'processed')]"/>
                <filter name="filter_pending_review" string="Pending Review" domain="[('processing_status', '=', 'pending_review')]"/>
                <filter name="filter_failed" string="Failed" domain="[('processing_status', '=', 'failed')]"/>
                <filter name="filter_invalid_signature" string="Invalid Signature" domain="[('processing_status', '=', 'invalid_signature')]"/>
                <filter name="filter_rate_limited" string="Rate Limited" domain="[('processing_status', '=', 'rate_limited')]"/>

                <separator/>

                <filter name="filter_signature_valid" string="Valid Signature" domain="[('signature_valid', '=', True)]"/>
                <filter name="filter_signature_invalid" string="Invalid Signature Flag" domain="[('signature_valid', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_by_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="group_by_platform" string="Platform" context="{'group_by': 'platform'}"/>
                    <filter name="group_by_event_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'processing_status'}"/>
                    <filter name="group_by_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ecommerce_webhook_event" model="ir.actions.act_window">
        <field name="name">Webhook Events</field>
        <field name="res_model">ecommerce.webhook.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ecommerce_webhook_event_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No webhook events yet.
            </p>
            <p>
                Incoming webhook requests will be stored here before any business processing.
            </p>
        </field>
    </record>

</odoo>